{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cartdistrict",
  "compatibility_date": "2026-11-10",
  "workers_dev": true,
  "assets": { "directory": "./public" },
  "env": {
    "staging": {
      "name": "cartdistrict-staging",
      "workers_dev": true,
      "routes": [{ "pattern": "staging.cartdistrict.com", "custom_domain": true }]
    }
  }
}
